# 服务端口
PORT=3000

# 前端地址（CORS 允许来源）
FRONTEND_URL=http://localhost:5173

# 公司 GitLab
GITLAB_URL=http://10.0.6.203:8088

# JWT 会话密钥（用 openssl rand -hex 32 生成）
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# 平台管理员（逗号分隔的 GitLab 用户名）
ADMIN_USERNAMES=

# 部署权限阈值（GitLab access_level：30=Developer 40=Maintainer）
DEPLOY_MIN_ACCESS_TEST=30
DEPLOY_MIN_ACCESS_PROD=40

# 飞书群机器人 webhook（部署进入终态时发通知；留空则用代码内置默认群机器人地址）
FEISHU_WEBHOOK=

# 说明：登录改为「用户填自己的 GitLab Personal Access Token」，
# 无需 OAuth 应用，故不再需要 GITLAB_CLIENT_ID / SECRET / OAUTH_REDIRECT_URI。
